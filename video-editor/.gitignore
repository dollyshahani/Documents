# Videos stay on the PC — only code, style and READMEs go to git.
Raw/*
!Raw/README.txt
Projects/*
!Projects/README.txt
*.mp4
*.mov
*.mkv
*.wav
.env
__pycache__/
# B-roll clips stay on the PC (index + sheets too: they describe local files)
B-roll/*
!B-roll/README.txt
!B-roll/mine/
!B-roll/stock/
!B-roll/ai/
B-roll/mine/*
B-roll/stock/*
B-roll/ai/*
!B-roll/*/.keep
